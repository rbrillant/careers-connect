# Server configuration
PORT=8787

# Public URL of the frontend (comma-separated list allowed). Use * for local dev.
# Example: https://careers-connect.vercel.app
CORS_ORIGIN=*

# Secret used to sign admin login tokens. Use a long random string in production.
JWT_SECRET=change-me-to-a-long-random-string

# Admin account created automatically on first start (if no users exist).
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-now

# ---- Database ---------------------------------------------------------
# Leave both blank to use a local SQLite file (great for development).
# Set both to use your hosted Turso database (recommended for production).
# Get these from https://turso.tech → your database → Connect.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# ---- Video storage ----------------------------------------------------
# STORAGE_DRIVER picks where videos are kept:
#   database -> inside the database as BLOBs (no other service needed)
#   remote   -> an S3-compatible bucket (IDrive e2 / Backblaze B2 / Cloudflare R2)
#   disk     -> a local uploads/ folder (development)
# Leave it blank to auto-select: remote if a bucket is configured, else database.
STORAGE_DRIVER=

# Maximum size of one stored video when STORAGE_DRIVER=database, in MB.
# Keep this small: the bytes count against your database's storage limit.
MAX_VIDEO_MB=25

# Leave the block below blank to keep videos in the database.
#
# OPTION A: IDrive e2 (free 10 GB, no credit card) — recommended.
#   IDrive → Object Storage → Buckets. The bucket page shows the endpoint.
#     E2_ACCESS_KEY_ID / E2_SECRET_ACCESS_KEY → Access Keys in the console
#     E2_ENDPOINT  → e.g. https://xyz1.ch11.idrivee2-2.com
#     E2_REGION    → the region shown for your endpoint (e.g. us-east-1)
#     E2_BUCKET    → your bucket name
#     E2_PUBLIC_URL → optional; only if the bucket is public
E2_ACCESS_KEY_ID=
E2_SECRET_ACCESS_KEY=
E2_ENDPOINT=
E2_REGION=
E2_BUCKET=
E2_PUBLIC_URL=

# OPTION B: Backblaze B2 (free 10 GB, no credit card).
#     B2_KEY_ID / B2_APPLICATION_KEY  → the keyID and applicationKey
#     B2_ENDPOINT  → e.g. https://s3.us-west-004.backblazeb2.com
#     B2_REGION    → e.g. us-west-004  (found in the endpoint URL)
#     B2_BUCKET    → your bucket name
#     B2_PUBLIC_URL → optional; only if the bucket is public
B2_KEY_ID=
B2_APPLICATION_KEY=
B2_ENDPOINT=
B2_REGION=
B2_BUCKET=
B2_PUBLIC_URL=

# OPTION C: Cloudflare R2 (requires a credit card to activate).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=

# Where locally stored videos (and the local SQLite file) live.
# On hosts with a persistent disk, point this at the mounted disk, e.g. /var/data
DATA_DIR=./data
